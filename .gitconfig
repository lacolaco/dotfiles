[core]
	excludesfile = /Users/lacolaco/.gitignore_global
	autocrlf = input
	editor = code --wait
	lockfilePid = true
[user]
	email = suguru.inatomi@gmail.com
	name = Suguru Inatomi
	signingkey = ~/.ssh/id_ed25519.pub
[color]
	ui = auto
[url "git@github.com:"]
    # insteadOf = https://github.com/
[init]
	defaultBranch = main
[fetch]
	prune = true
	followRemoteHEAD = always
[push]
	autoSetupRemote = true
[rebase]
	updateRefs = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[wt]
	basedir = {gitroot}/.git/wt
[include]
	path = ~/.gitconfig.local
